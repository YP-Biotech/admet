# admet analyze as a system-wide systemd service. `make systemd` fills in the @…@ values and installs it
# as /etc/systemd/system/admet-analyze.service; run it again with other values to change them.
[Unit]
Description=admet analyze
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
Environment=ADMET_HOME=@ADMET_HOME@
WorkingDirectory=@CHECKOUT@
ExecStart=@CHECKOUT@/.venv/bin/admet analyze --host @HOST@ --port @PORT@@DATA_ARG@
Restart=on-failure
RestartSec=5
# The server and the rig come first; an analysis runs lower still in its own process.
Nice=5

[Install]
WantedBy=multi-user.target
